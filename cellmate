#!/usr/bin/env bash
#
#         _ _            _
#  __ ___| | |_ __  __ _| |_ ___
# / _/ -_) | | '  \/ _` |  _/ -_)
# \__\___|_|_|_|_|_\__,_|\__\___|
#
#  keep your lipos alive         by @iamanuclearwarhead
#
# usage
#   cellmate                                      open the interactive tui
#   cellmate add <pack> -s <cells> -c <mah> [-C <c-rating>] [-b <brand>]
#   cellmate charge <pack>                        log a charge (counts a cycle)
#   cellmate fly <pack> [minutes]                 log a flight
#   cellmate storage <pack>                       log putting the pack in storage
#   cellmate ir <pack> <mohm> [mohm ...]          log per-cell internal resistance
#   cellmate puffy <pack>                         flag a pack as puffy
#   cellmate note <pack> <text>                   attach a note
#   cellmate list [-a]                            list packs (-a includes retired)
#   cellmate show <pack>                          pack details and history
#   cellmate retire <pack>                        retire a pack
#   cellmate stats                                fleet totals
set -euo pipefail

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/cellmate"
PACKS="$DATA_DIR/packs.tsv"
EVENTS="$DATA_DIR/events.tsv"

BOLD=$'\033[1m'
BLUE=$'\033[34m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
DIM=$'\033[90m'
RESET=$'\033[0m'

info()  { printf '%s\n' "${BLUE}::${RESET} $*"; }
ok()    { printf '%s\n' "${GREEN}::${RESET} $*"; }
warn()  { printf '%s\n' "${YELLOW}::${RESET} $*"; }
die()   { printf '%s\n' "${RED}error:${RESET} $*" >&2; exit 1; }

usage() {
    sed -n '2,/^set -euo/p' "$0" | head -n -1 | sed 's/^# \{0,1\}//'
    exit 0
}

mkdir -p "$DATA_DIR"
touch "$PACKS" "$EVENTS"

# packs.tsv:  name  cells  mah  c_rating  brand  added_epoch  status  puffy
# events.tsv: epoch  name  type  value  note

now() { date +%s; }

pack_row() { awk -F'\t' -v n="$1" '$1 == n' "$PACKS"; }

pack_exists() { [ -n "$(pack_row "$1")" ]; }

require_pack() {
    pack_exists "$1" || die "no pack named '$1' (see: cellmate list)"
}

pack_field() { pack_row "$1" | cut -f"$2"; }

set_pack_field() {  # name, column, value
    local tmp
    tmp="$(mktemp)"
    awk -F'\t' -v OFS='\t' -v n="$1" -v col="$2" -v val="$3" \
        '$1 == n { $col = val } { print }' "$PACKS" > "$tmp"
    mv "$tmp" "$PACKS"
}

log_event() {  # name, type, value, note
    printf '%s\t%s\t%s\t%s\t%s\n' "$(now)" "$1" "$2" "${3:-}" "${4:-}" >> "$EVENTS"
}

count_events() { awk -F'\t' -v n="$1" -v t="$2" '$2 == n && $3 == t' "$EVENTS" | wc -l; }

last_event() {  # name -> "epoch type" of the most recent charge/fly/storage event
    awk -F'\t' -v n="$1" '$2 == n && ($3 == "charge" || $3 == "fly" || $3 == "storage") \
        { e = $1; t = $3 } END { if (e) print e, t }' "$EVENTS"
}

latest_ir() {  # name -> most recent comma-joined mohm readings
    awk -F'\t' -v n="$1" '$2 == n && $3 == "ir" { v = $4 } END { print v }' "$EVENTS"
}

ir_avg() { printf '%s' "$1" | awk -F',' '{ s = 0; for (i = 1; i <= NF; i++) s += $i; printf "%.1f", s / NF }'; }
ir_max() { printf '%s' "$1" | awk -F',' '{ m = 0; for (i = 1; i <= NF; i++) if ($i > m) m = $i; printf "%.1f", m }'; }

days_ago() { awk -v t="$1" -v n="$(now)" 'BEGIN { printf "%d", (n - t) / 86400 }'; }

flags_for() {  # name -> space-separated warning flags
    local name="$1" out="" ir last
    [ "$(pack_field "$name" 8)" = "1" ] && out+="${RED}PUFFY${RESET} "
    ir="$(latest_ir "$name")"
    if [ -n "$ir" ]; then
        awk -v m="$(ir_max "$ir")" 'BEGIN { exit !(m >= 15) }' && out+="${RED}high IR${RESET} " \
            || { awk -v m="$(ir_max "$ir")" 'BEGIN { exit !(m >= 10) }' && out+="${YELLOW}IR rising${RESET} "; }
    fi
    last="$(last_event "$name")"
    if [ -n "$last" ] && [ "${last##* }" = "charge" ]; then
        local d; d="$(days_ago "${last%% *}")"
        [ "$d" -ge 3 ] && out+="${YELLOW}sitting full ${d}d${RESET} "
    fi
    [ "$(count_events "$name" charge)" -ge 150 ] && out+="${YELLOW}150+ cycles${RESET} "
    printf '%s' "$out"
}

cmd_add() {
    local name="${1:-}"; shift || true
    [ -n "$name" ] || die "usage: cellmate add <pack> -s <cells> -c <mah> [-C <c-rating>] [-b <brand>]"
    case "$name" in *[!a-zA-Z0-9_-]*) die "pack names: letters, numbers, - and _ only" ;; esac
    pack_exists "$name" && die "pack '$name' already exists"
    local cells="" mah="" crating="-" brand="-"
    while [ $# -gt 0 ]; do
        case "$1" in
            -s) cells="${2:-}"; shift 2 ;;
            -c) mah="${2:-}"; shift 2 ;;
            -C) crating="${2:-}"; shift 2 ;;
            -b) brand="${2:-}"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    case "$cells" in ''|*[!0-9]*) die "-s <cells> is required (e.g. -s 4 for 4S)" ;; esac
    case "$mah" in ''|*[!0-9]*) die "-c <mah> is required (e.g. -c 1500)" ;; esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$name" "$cells" "$mah" "$crating" "$brand" "$(now)" "active" "0" >> "$PACKS"
    ok "added ${BOLD}$name${RESET} (${cells}S ${mah}mAh)"
}

cmd_charge() {
    require_pack "$1"
    log_event "$1" charge
    ok "charged ${BOLD}$1${RESET} ${DIM}(cycle $(count_events "$1" charge))${RESET}"
}

cmd_fly() {
    require_pack "$1"
    local mins="${2:-}"
    case "$mins" in *[!0-9]*) die "minutes must be a number" ;; esac
    log_event "$1" fly "$mins"
    ok "logged flight on ${BOLD}$1${RESET}${mins:+ ${DIM}(${mins}min)${RESET}}"
}

cmd_storage() {
    require_pack "$1"
    log_event "$1" storage
    ok "${BOLD}$1${RESET} in storage, good pilot"
}

cmd_ir() {
    local name="${1:-}"; shift || true
    require_pack "$name"
    [ $# -gt 0 ] || die "usage: cellmate ir <pack> <mohm> [mohm ...]  (one reading per cell)"
    local cells; cells="$(pack_field "$name" 2)"
    [ $# -eq "$cells" ] || die "$name is ${cells}S, expected $cells readings, got $#"
    local r; for r in "$@"; do
        case "$r" in ''|*[!0-9.]*) die "readings are numbers in mohm, got: $r" ;; esac
    done
    local joined; joined="$(IFS=,; printf '%s' "$*")"
    log_event "$name" ir "$joined"
    ok "logged IR for ${BOLD}$name${RESET}: avg $(ir_avg "$joined")mΩ, worst cell $(ir_max "$joined")mΩ"
}

cmd_puffy() {
    require_pack "$1"
    set_pack_field "$1" 8 1
    log_event "$1" puffy
    warn "${BOLD}$1${RESET} flagged puffy, keep an eye on it (or retire it)"
}

cmd_note() {
    local name="${1:-}"; shift || true
    require_pack "$name"
    [ $# -gt 0 ] || die "usage: cellmate note <pack> <text>"
    log_event "$name" note "" "$*"
    ok "noted"
}

cmd_retire() {
    require_pack "$1"
    set_pack_field "$1" 7 retired
    log_event "$1" retire
    ok "${BOLD}$1${RESET} retired o7  ${DIM}(discharge fully and recycle it properly)${RESET}"
}

cmd_list() {
    local show_all="${1:-}"
    [ -s "$PACKS" ] || die "no packs yet (cellmate add <pack> -s 4 -c 1500)"
    printf '%s\n' "${BOLD}your packs:${RESET}"
    local name cells mah crating brand added status puffy
    while IFS=$'\t' read -r name cells mah crating brand added status puffy; do
        [ "$status" = "retired" ] && [ "$show_all" != "-a" ] && continue
        local cycles ir irtxt="" agetxt style=""
        cycles="$(count_events "$name" charge)"
        ir="$(latest_ir "$name")"
        [ -n "$ir" ] && irtxt="$(ir_avg "$ir")mΩ"
        agetxt="$(days_ago "$added")d"
        [ "$status" = "retired" ] && style="$DIM"
        printf '  %s%-14s %4sS %6smAh  %3s cycles  %6s  %4s%s  %s\n' \
            "$style$BOLD" "$name" "$cells" "$mah" "$cycles" "${irtxt:--}" "$agetxt" "$RESET" \
            "$([ "$status" = "retired" ] && printf '%s' "${DIM}retired${RESET}" || flags_for "$name")"
    done < "$PACKS"
}

cmd_show() {
    require_pack "$1"
    local name="$1"
    IFS=$'\t' read -r _ cells mah crating brand added status puffy <<< "$(pack_row "$name")"
    printf '%s\n' "${BOLD}$name${RESET}  ${DIM}${cells}S ${mah}mAh${RESET}"
    printf '  %-10s %s\n' "brand" "$brand"
    printf '  %-10s %s\n' "c rating" "$crating"
    printf '  %-10s %s days\n' "age" "$(days_ago "$added")"
    printf '  %-10s %s\n' "cycles" "$(count_events "$name" charge)"
    printf '  %-10s %s\n' "flights" "$(count_events "$name" fly)"
    printf '  %-10s %s\n' "status" "$status$( [ "$puffy" = 1 ] && printf '%s' " ${RED}(puffy)${RESET}")"
    local ir; ir="$(latest_ir "$name")"
    [ -n "$ir" ] && printf '  %-10s %s %s(avg %smΩ)%s\n' "last IR" "$ir" "$DIM" "$(ir_avg "$ir")" "$RESET"
    local flags; flags="$(flags_for "$name")"
    [ -n "$flags" ] && printf '  %-10s %s\n' "warnings" "$flags"
    printf '\n%s\n' "${BOLD}recent history:${RESET}"
    awk -F'\t' -v n="$name" '$2 == n' "$EVENTS" | tail -10 | \
        while IFS=$'\t' read -r epoch _ type value note; do
            printf '  %s%s%s  %-8s %s %s\n' "$DIM" "$(date -d "@$epoch" '+%Y-%m-%d %H:%M')" "$RESET" \
                "$type" "$value" "${note:+$DIM$note$RESET}"
        done
}

cmd_stats() {
    [ -s "$PACKS" ] || die "no packs yet"
    local total active retired cycles flights mins
    total="$(wc -l < "$PACKS")"
    retired="$(awk -F'\t' '$7 == "retired"' "$PACKS" | wc -l)"
    active=$((total - retired))
    cycles="$(awk -F'\t' '$3 == "charge"' "$EVENTS" | wc -l)"
    flights="$(awk -F'\t' '$3 == "fly"' "$EVENTS" | wc -l)"
    mins="$(awk -F'\t' '$3 == "fly" && $4 != "" { s += $4 } END { print s + 0 }' "$EVENTS")"
    printf '%s\n' "${BOLD}fleet stats:${RESET}"
    printf '  %-14s %s active, %s retired\n' "packs" "$active" "$retired"
    printf '  %-14s %s\n' "total cycles" "$cycles"
    printf '  %-14s %s%s\n' "total flights" "$flights" "${mins:+ (${mins}min logged)}"
}

# ── tui ──────────────────────────────────────────────────────────────

TUI_SEL=0
TUI_ALL=0
TUI_MSG=""
T_NAMES=()
OUT=""

put() { local _p; printf -v _p '\033[%d;%dH' "$1" "$2"; OUT+="$_p$3"; }

repeat() { local i s=""; for ((i = 0; i < $1; i++)); do s+="$2"; done; printf '%s' "$s"; }

tui_load() {
    T_NAMES=()
    local name rest
    while IFS=$'\t' read -r name rest; do
        [ -z "$name" ] && continue
        if [ "$TUI_ALL" = 1 ] || [ "$(pack_field "$name" 7)" != "retired" ]; then
            T_NAMES+=("$name")
        fi
    done < "$PACKS"
    if [ "${#T_NAMES[@]}" -eq 0 ]; then
        TUI_SEL=0
    elif [ "$TUI_SEL" -ge "${#T_NAMES[@]}" ]; then
        TUI_SEL=$((${#T_NAMES[@]} - 1))
    fi
}

tui_box() {  # top left bottom right title
    local t=$1 l=$2 b=$3 r=$4 title=$5 i h
    h="$(repeat $((r - l - 1)) '─')"
    put "$t" "$l" "${DIM}╭${h}╮${RESET}"
    for ((i = t + 1; i < b; i++)); do
        put "$i" "$l" "${DIM}│${RESET}"
        put "$i" "$r" "${DIM}│${RESET}"
    done
    put "$b" "$l" "${DIM}╰${h}╯${RESET}"
    put "$t" $((l + 2)) "${BOLD} $title ${RESET}"
}

hint() { printf '%s' "${BOLD}${BLUE}$1${RESET}${DIM} $2${RESET}  "; }

tui_draw() {
    local ROWS COLS
    ROWS=$(tput lines); COLS=$(tput cols)
    OUT=$'\033[2J\033[?7l'
    if [ "$ROWS" -lt 14 ] || [ "$COLS" -lt 64 ]; then
        put 2 2 "terminal too smol, resize me"
        put 3 2 "${DIM}(or press q to quit)${RESET}"
        printf '%s' "$OUT"
        return
    fi
    local top=3 bot=$((ROWS - 2)) lw=34
    local dl=$((lw + 2)) c=$((lw + 4))

    local stats
    stats="$(awk -F'\t' '{t++} $7=="retired"{r++} END{printf "%d active / %d retired", t-r, r}' "$PACKS")"
    put 1 2 "${BOLD}${YELLOW}⚡ cellmate${RESET}"
    put 1 $((COLS - ${#stats} - 1)) "${DIM}${stats}${RESET}"

    tui_box "$top" 1 "$bot" "$lw" "packs$( [ "$TUI_ALL" = 1 ] && printf '%s' ' +retired' )"
    tui_box "$top" "$dl" "$bot" "$COLS" "details"

    # pack list
    local cap=$((bot - top - 1)) off=0 i row=$((top + 1))
    [ "$TUI_SEL" -ge "$cap" ] && off=$((TUI_SEL - cap + 1))
    for ((i = off; i < ${#T_NAMES[@]} && row < bot; i++, row++)); do
        local n="${T_NAMES[i]}" fl dot label
        fl="$(flags_for "$n")"
        if [ "$(pack_field "$n" 7)" = "retired" ]; then dot="${DIM}●${RESET}"
        elif [[ "$fl" == *PUFFY* || "$fl" == *"high IR"* ]]; then dot="${RED}●${RESET}"
        elif [ -n "$fl" ]; then dot="${YELLOW}●${RESET}"
        else dot="${GREEN}●${RESET}"
        fi
        label="$(printf '%-14.14s %2sS %5s' "$n" "$(pack_field "$n" 2)" "$(pack_field "$n" 3)")"
        if [ "$i" -eq "$TUI_SEL" ]; then
            put "$row" 3 "${BOLD}${BLUE}❯${RESET} ${dot} ${BOLD}${label}${RESET}"
        else
            put "$row" 3 "  ${dot} ${DIM}${label}${RESET}"
        fi
    done
    [ "${#T_NAMES[@]}" -eq 0 ] && put $((top + 1)) 3 "${DIM}no packs yet${RESET}"

    # details
    if [ "${#T_NAMES[@]}" -gt 0 ]; then
        local sel="${T_NAMES[TUI_SEL]}" cells mah crating brand added status puffy r2=$((top + 1))
        IFS=$'\t' read -r _ cells mah crating brand added status puffy <<< "$(pack_row "$sel")"
        put "$r2" "$c" "${BOLD}${sel}${RESET}  ${DIM}${cells}S ${mah}mAh${RESET}"; r2=$((r2 + 2))
        put "$r2" "$c" "${DIM}brand${RESET}     $brand   ${DIM}c rating${RESET} $crating"; r2=$((r2 + 1))
        put "$r2" "$c" "${DIM}age${RESET}       $(days_ago "$added")d   ${DIM}cycles${RESET} $(count_events "$sel" charge)   ${DIM}flights${RESET} $(count_events "$sel" fly)"; r2=$((r2 + 1))
        put "$r2" "$c" "${DIM}status${RESET}    $status$( [ "$puffy" = 1 ] && printf '%s' " ${RED}(puffy)${RESET}" )"; r2=$((r2 + 1))
        local ir; ir="$(latest_ir "$sel")"
        if [ -n "$ir" ]; then
            put "$r2" "$c" "${DIM}last ir${RESET}   $ir mΩ ${DIM}(avg $(ir_avg "$ir"), worst $(ir_max "$ir"))${RESET}"; r2=$((r2 + 1))
        fi
        local fl; fl="$(flags_for "$sel")"
        if [ -n "$fl" ]; then
            put "$r2" "$c" "${DIM}warnings${RESET}  $fl"; r2=$((r2 + 1))
        fi
        r2=$((r2 + 1))
        local avail=$((bot - r2 - 1))
        if [ "$avail" -gt 0 ]; then
            put "$r2" "$c" "${BOLD}recent:${RESET}"; r2=$((r2 + 1))
            local epoch _n type value note
            while IFS=$'\t' read -r epoch _n type value note; do
                put "$r2" "$c" "${DIM}$(date -d "@$epoch" '+%m-%d %H:%M')${RESET}  $(printf '%-7s' "$type") $value${note:+ ${DIM}$(printf '%.28s' "$note")${RESET}}"
                r2=$((r2 + 1))
            done < <(awk -F'\t' -v n="$sel" '$2 == n' "$EVENTS" | tail -n $((avail - 1)))
        fi
    else
        put $((top + 1)) "$c" "press ${BOLD}${BLUE}a${RESET} to add your first pack"
    fi

    [ -n "$TUI_MSG" ] && put $((ROWS - 1)) 2 "$TUI_MSG"
    put "$ROWS" 2 "$(hint j/k nav; hint c charge; hint f fly; hint s storage; hint i ir; hint n note; hint p puffy; hint a add; hint r retire; hint d retired; hint q quit)"
    printf '%s' "$OUT"
}

tui_prompt() {  # question -> $REPLY
    local ROWS; ROWS=$(tput lines)
    printf '\033[%d;2H\033[2K%s ' "$((ROWS - 1))" "${BOLD}${BLUE}?${RESET} ${BOLD}$1${RESET}"
    tput cnorm; stty echo
    IFS= read -r REPLY || REPLY=""
    tput civis; stty -echo
}

cmd_tui() {
    [ -t 1 ] || usage
    exec < /dev/tty
    local stty_orig; stty_orig="$(stty -g)"
    tput smcup; tput civis; stty -echo
    trap "stty $stty_orig; printf '\\033[?7h'; tput cnorm; tput rmcup" EXIT
    trap : WINCH
    local key k2 sel REPLY
    while :; do
        tui_load
        tui_draw
        IFS= read -rsn1 key || { TUI_MSG=""; continue; }
        if [ "$key" = $'\033' ]; then
            k2=""; IFS= read -rsn2 -t 0.05 k2 || true
            key+="$k2"
        fi
        TUI_MSG=""
        sel=""
        [ "${#T_NAMES[@]}" -gt 0 ] && sel="${T_NAMES[TUI_SEL]}"
        case "$key" in
            q|Q) break ;;
            j|$'\033[B') [ "$TUI_SEL" -lt $(( ${#T_NAMES[@]} - 1 )) ] && TUI_SEL=$((TUI_SEL + 1)) ;;
            k|$'\033[A') [ "$TUI_SEL" -gt 0 ] && TUI_SEL=$((TUI_SEL - 1)) ;;
            g) TUI_SEL=0 ;;
            G) TUI_SEL=$(( ${#T_NAMES[@]} - 1 )); [ "$TUI_SEL" -lt 0 ] && TUI_SEL=0 ;;
            d) TUI_ALL=$((1 - TUI_ALL)) ;;
            c) if [ -n "$sel" ]; then
                   log_event "$sel" charge
                   TUI_MSG="${GREEN}::${RESET} charged ${BOLD}$sel${RESET} (cycle $(count_events "$sel" charge))"
               fi ;;
            f) if [ -n "$sel" ]; then
                   tui_prompt "flight minutes for $sel (empty = unknown):"
                   case "$REPLY" in
                       *[!0-9]*) TUI_MSG="${RED}::${RESET} not a number, flight not logged" ;;
                       *) log_event "$sel" fly "$REPLY"
                          TUI_MSG="${GREEN}::${RESET} logged flight on ${BOLD}$sel${RESET}" ;;
                   esac
               fi ;;
            s) if [ -n "$sel" ]; then
                   log_event "$sel" storage
                   TUI_MSG="${GREEN}::${RESET} ${BOLD}$sel${RESET} in storage, good pilot"
               fi ;;
            i) if [ -n "$sel" ]; then
                   local cells bad joined r
                   cells="$(pack_field "$sel" 2)"
                   tui_prompt "IR for $sel in mΩ, $cells readings (e.g. 8.2 8.5 ...):"
                   local -a irs=()
                   read -ra irs <<< "$REPLY" || true
                   bad=""
                   for r in "${irs[@]}"; do case "$r" in ''|*[!0-9.]*) bad=1 ;; esac; done
                   if [ -n "$bad" ] || [ "${#irs[@]}" -ne "$cells" ]; then
                       TUI_MSG="${RED}::${RESET} expected $cells numeric readings, got ${#irs[@]}"
                   else
                       joined="$(IFS=,; printf '%s' "${irs[*]}")"
                       log_event "$sel" ir "$joined"
                       TUI_MSG="${GREEN}::${RESET} IR logged: avg $(ir_avg "$joined")mΩ, worst $(ir_max "$joined")mΩ"
                   fi
               fi ;;
            n) if [ -n "$sel" ]; then
                   tui_prompt "note for $sel:"
                   if [ -n "$REPLY" ]; then
                       log_event "$sel" note "" "$REPLY"
                       TUI_MSG="${GREEN}::${RESET} noted"
                   fi
               fi ;;
            p) if [ -n "$sel" ]; then
                   set_pack_field "$sel" 8 1
                   log_event "$sel" puffy
                   TUI_MSG="${YELLOW}::${RESET} ${BOLD}$sel${RESET} flagged puffy"
               fi ;;
            a) tui_prompt "add pack: <name> <cells> <mah> [c-rating] [brand]"
               local an ac am acr ab extra
               read -r an ac am acr ab extra <<< "$REPLY" || true
               if [ -z "${am:-}" ]; then
                   [ -n "$REPLY" ] && TUI_MSG="${RED}::${RESET} need at least: name cells mah"
               elif ! [[ "$an" =~ ^[a-zA-Z0-9_-]+$ ]]; then
                   TUI_MSG="${RED}::${RESET} names: letters, numbers, - and _ only"
               elif pack_exists "$an"; then
                   TUI_MSG="${RED}::${RESET} pack '$an' already exists"
               elif [[ "$ac" =~ [^0-9] || "$am" =~ [^0-9] ]]; then
                   TUI_MSG="${RED}::${RESET} cells and mah must be numbers"
               else
                   printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                       "$an" "$ac" "$am" "${acr:--}" "${ab:--}" "$(now)" "active" "0" >> "$PACKS"
                   TUI_MSG="${GREEN}::${RESET} added ${BOLD}$an${RESET} (${ac}S ${am}mAh)"
               fi ;;
            r) if [ -n "$sel" ]; then
                   tui_prompt "retire $sel? [y/N]"
                   case "$REPLY" in
                       y|Y|yes) set_pack_field "$sel" 7 retired; log_event "$sel" retire
                                TUI_MSG="${GREEN}::${RESET} ${BOLD}$sel${RESET} retired o7" ;;
                       *) TUI_MSG="${DIM}not retired${RESET}" ;;
                   esac
               fi ;;
        esac
    done
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
    -h|--help) usage ;;
    ""|tui)   cmd_tui ;;
    add)      cmd_add "$@" ;;
    charge)   [ $# -ge 1 ] || die "usage: cellmate charge <pack>"; cmd_charge "$@" ;;
    fly)      [ $# -ge 1 ] || die "usage: cellmate fly <pack> [minutes]"; cmd_fly "$@" ;;
    storage)  [ $# -ge 1 ] || die "usage: cellmate storage <pack>"; cmd_storage "$@" ;;
    ir)       cmd_ir "$@" ;;
    puffy)    [ $# -ge 1 ] || die "usage: cellmate puffy <pack>"; cmd_puffy "$@" ;;
    note)     cmd_note "$@" ;;
    list)     cmd_list "${1:-}" ;;
    show)     [ $# -ge 1 ] || die "usage: cellmate show <pack>"; cmd_show "$@" ;;
    retire)   [ $# -ge 1 ] || die "usage: cellmate retire <pack>"; cmd_retire "$@" ;;
    stats)    cmd_stats ;;
    *)        die "unknown command: $cmd (try --help)" ;;
esac
